@page "/statistics"
@inherits Components.BaseComponent
@inject CardManager CardManager
@inject StatisticsManager StatisticsManager
@inject SupportedCards SupportedCards
@inject GameState GameState
@using System.Text.Json

<div class="app-grid-container">

    <div class="grid-button1 ">
        <button type="button" class="social-btn standard-btn"
                @onclick="@CheckDeck">
            <img src="./deck.svg">
            <span>Check Deck</span>
        </button>
    </div>

    <div class="grid-button2">
        <button type="button" class="social-btn standard-btn"
                @onclick="() => HandTestButton(true)">
            <img src="./card.svg">
            <span>Check Hand</span>
        </button>
    </div>

    <div class="grid-button3">
        <button type="button" class="social-btn reset-btn"
                @onclick='ResetCards'>
            <img src="./reset.svg">
            <span>Reset</span>
        </button>
    </div>

    <div class="grid-options">
        <div class="option-progress-wrap">
            <div class="option-progress-bar" style="width: @($"{(double)StatisticsManager.StatValues.ProgressCount / StatisticsManager.StatValues.MaximumCount * 100}%")"></div>
            <div class="option-content">
                <div class="option-field">
                    <span class="option-label">Hand Size</span>
                    <input type="text" class="option-input" @bind-value="StatisticsManager.StatValues.StartingHand" />
                </div>
                <div class="option-divider"></div>
                <div class="option-field">
                    <span class="option-label">Sample Size</span>
                    @if (StatisticsManager.StatValues.Active)
                    {
                        <input type="text" class="option-input" @bind-value="StatisticsManager.StatValues.CurrentCount" readonly />
                    }
                    else
                    {
                        <input type="text" class="option-input" @bind-value="StatisticsManager.StatValues.MaximumCount" />
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="grid-stats">

        <div class="stats-hdr">
            <span>Statistic</span>
            <span>Value</span>
            <span>Variance</span>
        </div>

        <div class="stats-section">Basic Stats</div>
        <div class="stats-group">
            <div class="stats-row"><span class="stats-name">Deck Size</span><span class="stats-val">@StatisticsManager.DisplayValues.DeckSize</span><div class="stats-var"></div></div>
            <div class="stats-row"><span class="stats-name">Total Monsters</span><span class="stats-val">@StatisticsManager.DisplayValues.TotalMonsters</span><div class="stats-var"></div></div>
            <div class="stats-row"><span class="stats-name">Combo Chance</span><span class="stats-val">@StatisticsManager.DisplayValues.ComboChance%</span>
                <div class="stats-var"><button @onclick="() => VarianceButton(VarianceStat.ComboChance)">± var</button></div></div>
            <div class="stats-row"><span class="stats-name">Brick Chance</span><span class="stats-val">@StatisticsManager.DisplayValues.BrickChance%</span>
                <div class="stats-var"><button @onclick="() => VarianceButton(VarianceStat.BrickChance)">± var</button></div></div>
            <div class="stats-row"><span class="stats-name">Brick Rate</span><span class="stats-val">1 In @StatisticsManager.DisplayValues.BrickRate</span>
                <div class="stats-var"></div></div>
        </div>

        <div class="stats-section">Summon Stats</div>
        <div class="stats-group">
            <div class="stats-row"><span class="stats-name">Xyz Summon (0 Tellars)</span><span class="stats-val">@StatisticsManager.DisplayValues.XyzSummonZero%</span>
                <div class="stats-var"><button @onclick="() => VarianceButton(VarianceStat.XyzSummonZero)">± var</button></div></div>
            <div class="stats-row"><span class="stats-name">Xyz Summon (1 Tellar)</span><span class="stats-val">@StatisticsManager.DisplayValues.XyzSummonOne%</span>
                <div class="stats-var"><button @onclick="() => VarianceButton(VarianceStat.XyzSummonOne)">± var</button></div></div>
            <div class="stats-row"><span class="stats-name">Xyz Summon (2 Tellars)</span><span class="stats-val">@StatisticsManager.DisplayValues.XyzSummonTwo%</span>
                <div class="stats-var"><button @onclick="() => VarianceButton(VarianceStat.XyzSummonTwo)">± var</button></div></div>
            <div class="stats-row"><span class="stats-name">Pendulum Chance</span><span class="stats-val">@StatisticsManager.DisplayValues.PendulumnChance%</span>
                <div class="stats-var"><button @onclick="() => VarianceButton(VarianceStat.PendulumnChance)">± var</button></div></div>
        </div>

        <div class="stats-section">Hand Stats</div>
        <div class="stats-group">
            <div class="stats-row"><span class="stats-name">Avg # Tellars</span><span class="stats-val">@StatisticsManager.DisplayValues.AverageHandTellars</span>
                <div class="stats-var"><button @onclick="() => VarianceButton(VarianceStat.AverageHandTellars)">± var</button></div></div>
            <div class="stats-row"><span class="stats-name">Avg # Extenders</span><span class="stats-val">@StatisticsManager.DisplayValues.AverageHandExtenders</span>
                <div class="stats-var"><button @onclick="() => VarianceButton(VarianceStat.AverageHandExtenders)">± var</button></div></div>
            <div class="stats-row"><span class="stats-name">Avg # Hand Traps</span><span class="stats-val">@StatisticsManager.DisplayValues.AverageHandHT</span>
                <div class="stats-var"><button @onclick="() => VarianceButton(VarianceStat.AverageHandHT)">± var</button></div></div>
        </div>

        <div class="stats-section">Other Stats</div>
        <div class="stats-group">
            <div class="stats-row"><span class="stats-name">Ryzeal Lock Chance</span><span class="stats-val">@StatisticsManager.DisplayValues.RyzealLockChance%</span><div class="stats-var"><button @onclick="() => VarianceButton(VarianceStat.RyzealLockChance)">± var</button></div></div>
        </div>

    </div>

</div>

@if (showHandTest)
{
    <div class="ydk-backdrop" @onclick="() => HandTestButton(false)">
        <div class="modal-content" @onclick:stopPropagation>
            <button type="button" class="modal-close" @onclick="() => HandTestButton(false)">✕</button>
            <div class="grid-statistics-extra">
                <div class="hand-test-container">

                    <button type="button"
                            class="social-btn standard-btn hand-test-button"
                            @onclick="CheckHand">
                        Check Hand
                    </button>

                    <div class="hand-test-result">
                        <b>Result:</b>

                        @if (!StatisticsManager.StatValues.HandTested)
                        {
                            <span>N/A</span>
                        }
                        else if (StatisticsManager.DeckStatisticsHand.BrickChance != 0)
                        {
                            <span>Bricked!</span>
                        }
                        else
                        {
                            <span>Success!</span>
                        }
                    </div>

                    <div class="card-container">
                        @foreach (Card card in StatisticsManager.StatValues.HandTest)
                        {
                            <div class="grid-item">
                                <img src="@card.Image"
                                     alt="@card.Name"
                                     title="@GenerateCardTooltip(card)"
                                     loading="lazy"
                                     class="item-image" />
                            </div>
                        }

                        @if (StatisticsManager.StatValues.HandTest.Count < 6)
                        {
                            <div class="grid-item">
                                <img src="./CardArt/Empty.jpg"
                                     alt="Empty"
                                     class="item-image" />
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
}

@if (showVariance)
{
    <div class="ydk-backdrop" @onclick="() => VarianceExitButton()">
        <div class="modal-content variance-modal" @onclick:stopPropagation>
            <button type="button" class="variance-close" @onclick="() => VarianceExitButton()">✕</button>
            <div class="grid-statistics-extra">
                <div class="variance-title">@GetVarianceStatLabel(selectedvariance) Variance</div>
                @if (StatisticsManager.DisplayValuesVariance.Any())
                {
                    double minVal = StatisticsManager.DisplayValuesVariance.Min(x => x[selectedvariance]);
                    double maxVal = StatisticsManager.DisplayValuesVariance.Max(x => x[selectedvariance]);
                    <div class="variance-range">
                        Range: @minVal.ToString("F2") to @maxVal.ToString("F2")
                    </div>
                    <div class="variance-columns">
                        @{
                            int half = (StatisticsManager.DisplayValuesVariance.Count + 1) / 2;
                            var leftColumn = StatisticsManager.DisplayValuesVariance.Take(half);
                            var rightColumn = StatisticsManager.DisplayValuesVariance.Skip(half);
                        }
                        <div class="variance-table">
                            <div class="variance-hdr">
                                <span>Sample #</span>
                                <span>Value</span>
                            </div>
                            <div class="variance-list">
                                @foreach (DisplayValues item in leftColumn)
                                {
                                    <div class="variance-row">
                                        <span class="variance-count">@item.Count</span>
                                        <span class="variance-value">@item[selectedvariance].ToString("F2")</span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="variance-table variance-table-right">
                            <div class="variance-hdr">
                                <span>Sample #</span>
                                <span>Value</span>
                            </div>
                            <div class="variance-list">
                                @foreach (DisplayValues item in rightColumn)
                                {
                                    <div class="variance-row">
                                        <span class="variance-count">@item.Count</span>
                                        <span class="variance-value">@item[selectedvariance].ToString("F2")</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="variance-empty">No data yet — run a check first.</div>
                }
            </div>
        </div>
    </div>
}

@code {
    VarianceStat selectedvariance;
    private bool showVariance = false;
    private bool showHandTest = false;
    GameState tempGameState = new GameState();

    protected override void OnInitialized()
    {
        StatisticsManager.ActionRefresh += OnRefresh;
        CardManager.BuildDecklist();
    }

    private async Task HandTestButton(bool value)
    {
        showHandTest = value;
        StatisticsManager.StatValues.ResetHandValues();
        await InvokeAsync(StateHasChanged);
    }

    private async Task VarianceButton(VarianceStat stat)
    {
        selectedvariance = stat;
        showVariance = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task VarianceExitButton()
    {
        showVariance = false;
        await InvokeAsync(StateHasChanged);
    }

    private async void OnRefresh()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task CheckDeck()
    {
        if (!StatisticsManager.StatValues.Active)
            await StatisticsManager.CheckDeck(CardManager.MainDeck, CardManager.ExtraDeck);
    }

    public async Task ResetCards()
    {
        CardManager.RefreshCards();
        GameState.RefreshGameState(CardManager.MainDeck, CardManager.ExtraDeck);
        SupportedCards.RefreshUpdate();
        StatisticsManager.StatValues.Idle = true;
        StatisticsManager.RefreshStatistics();
    }

    private async Task CheckHand()
    {
        tempGameState = await StatisticsManager.CheckHand(CardManager.MainDeck, CardManager.ExtraDeck, tempGameState);
        await InvokeAsync(StateHasChanged);
    }

    private Card? GetHandCard(int index)
    {
        return index >= 0 && index < tempGameState.Hand.Count
            ? tempGameState.Hand[index]
            : null;
    }

    public static string GenerateCardTooltip(Card card)
    {
        var lines = new List<string> { $"Name: {card.Name}" };

        if (!string.IsNullOrEmpty(card.Type))
            lines.Add($"Type: {card.Type}");
        if (!string.IsNullOrEmpty(card.Attribute))
            lines.Add($"Attribute: {card.Attribute}");
        if (card.Level.HasValue)
            lines.Add($"Level/Rank: {card.Level}");
        if (card.Scale.HasValue)
            lines.Add($"Scale: {card.Scale}");
        if (card.Attack.HasValue || card.Defense.HasValue)
            lines.Add($"ATK/DEF: {card.Attack.Value.ToString()}/{card.Defense.Value.ToString()}");

        if (card.Archetype != null && card.Archetype.Count > 0)
            lines.Add($"Archetype: {string.Join(", ", card.Archetype)}");
        else
            lines.Add("Archetype: N/A");

        return string.Join("\n", lines);
    }

    private static string GetVarianceStatLabel(VarianceStat stat) => stat switch
    {
        VarianceStat.ComboChance => "Combo Chance",
        VarianceStat.BrickChance => "Brick Chance",
        VarianceStat.BrickRate => "Brick Rate",
        VarianceStat.XyzSummonZero => "Xyz Summon (0 Tellars)",
        VarianceStat.XyzSummonOne => "Xyz Summon (1 Tellar)",
        VarianceStat.XyzSummonTwo => "Xyz Summon (2 Tellars)",
        VarianceStat.PendulumnChance => "Pendulum Chance",
        VarianceStat.OracleChance => "Oracle Chance",
        VarianceStat.AverageHandTellars => "Avg # Tellars",
        VarianceStat.AverageHandExtenders => "Avg # Extenders",
        VarianceStat.AverageHandHT => "Avg # Hand Traps",
        VarianceStat.RyzealLockChance => "Ryzeal Lock Chance",
        _ => stat.ToString()
    };
}